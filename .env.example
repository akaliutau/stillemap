# ---------- GCP deployment ----------
# PROJECT_ID defaults to GOOGLE_CLOUD_PROJECT when blank.
PROJECT_ID=
REGION=europe-west2
REPOSITORY=stillemap
SERVICE_NAME=stillemap
IMAGE_NAME=app
SA_NAME=stillemap-run

# Keep one warm instance for the hackathon demo; set to 0 afterwards.
CLOUD_RUN_CPU=4
CLOUD_RUN_MEMORY=8Gi
CLOUD_RUN_CONCURRENCY=1
CLOUD_RUN_TIMEOUT=900
CLOUD_RUN_MIN_INSTANCES=1
CLOUD_RUN_MAX_INSTANCES=2
CLOUD_RUN_ALLOW_UNAUTHENTICATED=true

# Secret Manager names. deploy_infra.sh creates/updates these only when the
# corresponding local value exists; otherwise that provider remains unavailable.
GOOGLE_MAPS_SECRET_NAME=stillemap-google-maps-api-key
TFL_SECRET_NAME=stillemap-tfl-app-key
GEMINI_SECRET_NAME=stillemap-gemini-api-key

# ---------- Google ----------
# Geocoding + Weather API key (Maps Platform APIs)
GOOGLE_MAPS_API_KEY=

# Vertex AI / Gemini. Keep GOOGLE_GENAI_USE_VERTEXAI=true for hackathon GCP creds.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-3.8-flash

# Optional alternative: direct Gemini API instead of Vertex AI.
# Set GOOGLE_GENAI_USE_VERTEXAI=false and provide GEMINI_API_KEY.
GEMINI_API_KEY=

# ---------- TfL ----------
TFL_APP_KEY=
TFL_CAMERA_RADIUS_M=1000

# ---------- DfT ----------
DFT_YEAR=2025
DFT_REGION_NAME=London
DFT_PAGE_SIZE=1000
DFT_NEARBY_RADIUS_M=1500
DFT_ROAD_MATCH_RADIUS_M=60
DFT_MAX_POINTS=40

# ---------- Geometry / simulation ----------
OSM_RADIUS_M=450
SIM_RADIUS_M=400
RECEIVER_GRID_M=25
RECEIVER_HEIGHT_M=4
TARGET_EPSG=27700
NOISE_MAX_SOURCE_DISTANCE_M=300
NOISE_REFLECTION_ORDER=0
NOISE_DIFF_HORIZONTAL=false
NOISE_DIFF_VERTICAL=false

# Browser noise map: use the combined day/evening/night result and keep raw
# dB values untouched; display floor/ceiling only control visualization weight.
NOISE_MAP_PERIOD=DEN
NOISE_DISPLAY_MIN_DB=35
NOISE_DISPLAY_MAX_DB=80

# AADF -> hourly D/E/N conversion assumptions. These are explicit modelling assumptions,
# not hidden fallbacks. They must sum to 1.0.
TRAFFIC_DAY_SHARE=0.70
TRAFFIC_EVENING_SHARE=0.20
TRAFFIC_NIGHT_SHARE=0.10

# Missing traffic policy for roads not matched to DfT:
#   skip    -> exclude the road from acoustic simulation
#   average -> use mean of observed matched roads for required fields
# The demo UI requires a complete neighbourhood surface, so average is explicit default.
TRAFFIC_MISSING_POLICY=average

# AI camera observation can adjust observed DfT baseline.
AI_LIVE_TRAFFIC_ENABLED=true
AI_MIN_CONFIDENCE=0.55

# ---------- NoiseModelling ----------
NM_MODE=docker
NM_DOCKER_IMAGE=stillemap/noisemodelling:6.0.0
# Local workstation requires sudo for Docker; Cloud Run overrides NM_MODE=local.
NM_DOCKER_SUDO=true
NM_LOCAL_HOME=
NM_TIMEOUT_SEC=600

# ---------- Runtime ----------
RUNS_DIR=./runs
HTTP_TIMEOUT_SEC=30
DEBUG=true

