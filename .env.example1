# ---------- Google ----------
# Geocoding + Weather API key (Maps Platform APIs)
GOOGLE_MAPS_API_KEY=

# Vertex AI / Gemini. Keep GOOGLE_GENAI_USE_VERTEXAI=true for hackathon GCP creds.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-3.8-flash

# Optional alternative: direct Gemini API instead of Vertex AI.
# Set GOOGLE_GENAI_USE_VERTEXAI=false and provide GEMINI_API_KEY.
GEMINI_API_KEY=

# ---------- TfL ----------
TFL_APP_KEY=
TFL_CAMERA_RADIUS_M=1000

# ---------- DfT ----------
DFT_YEAR=2025
DFT_REGION_NAME=London
DFT_PAGE_SIZE=1000
DFT_NEARBY_RADIUS_M=1500
DFT_ROAD_MATCH_RADIUS_M=60
DFT_MAX_POINTS=40

# ---------- Geometry / simulation ----------
OSM_RADIUS_M=450
SIM_RADIUS_M=400
RECEIVER_GRID_M=25
RECEIVER_HEIGHT_M=4
TARGET_EPSG=27700
NOISE_MAX_SOURCE_DISTANCE_M=300
NOISE_REFLECTION_ORDER=0
NOISE_DIFF_HORIZONTAL=false
NOISE_DIFF_VERTICAL=false

# AADF -> hourly D/E/N conversion assumptions. These are explicit modelling assumptions,
# not hidden fallbacks. They must sum to 1.0.
TRAFFIC_DAY_SHARE=0.70
TRAFFIC_EVENING_SHARE=0.20
TRAFFIC_NIGHT_SHARE=0.10

# Missing traffic policy for roads not matched to DfT:
#   skip    -> exclude the road from acoustic simulation
#   average -> use mean of observed matched roads for required fields
TRAFFIC_MISSING_POLICY=skip

# AI camera observation can adjust observed DfT baseline.
AI_LIVE_TRAFFIC_ENABLED=true
AI_MIN_CONFIDENCE=0.55

# ---------- NoiseModelling ----------
NM_MODE=docker
NM_DOCKER_IMAGE=stillemap/noisemodelling:6.0.0
NM_LOCAL_HOME=
NM_TIMEOUT_SEC=600

# ---------- Runtime ----------
RUNS_DIR=./runs
HTTP_TIMEOUT_SEC=30
DEBUG=true
